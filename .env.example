# PostgreSQL / Prisma
POSTGRES_USER="cultura"
POSTGRES_PASSWORD="cultura-local-only"
DATABASE_URL="postgresql://cultura:cultura-local-only@localhost:5432/cultura_platform?schema=public"
# Optional Docker override for remote PostgreSQL; include sslmode=require when required by the provider.
# EXTERNAL_DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/cultura_platform?schema=public&sslmode=require"
# RUN_DB_SEED=true  # Only seed a remote database intentionally.

# Auth.js
AUTH_SECRET="replace-with-a-long-random-local-secret"
AUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"

# RustFS / Media (S3 compatible)
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cultura-media"
S3_ACCESS_KEY_ID="replace-with-your-rustfs-access-key"
S3_SECRET_ACCESS_KEY="replace-with-your-rustfs-secret-key"
S3_FORCE_PATH_STYLE="true"
RUSTFS_CORS_ALLOWED_ORIGINS="http://localhost:3000"
RUSTFS_DATA_DIR="/srv/cultura-platform/rustfs"

# Frontend / MapLibre
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Geocoding externo (servidor solamente, plan Free de Geoapify)
GEOAPIFY_API_KEY=""
GEOAPIFY_BASE_URL="https://api.geoapify.com"

# Runtime
NODE_ENV="development"
