generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CREATOR
  MODERATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  mustChangePassword Boolean @default(false)
  role           Role            @default(USER)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         Event[]         @relation("EventAuthor")
  places         Place[]         @relation("PlaceAuthor")
  eventFavorites EventFavorite[]
  placeFavorites PlaceFavorite[]
  mediaAssets    MediaAsset[]
  auditLogs      AuditLog[]

  @@index([email])
}

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique @db.VarChar(2)
  slug      String   @unique
  createdAt DateTime @default(now())
  regions   Region[]
}

model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String
  countryId String
  createdAt DateTime @default(now())
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, slug])
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String
  regionId  String
  createdAt DateTime @default(now())
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  places    Place[]

  @@unique([regionId, slug])
  @@index([slug])
}

model Place {
  id          String                                 @id @default(cuid())
  name        String
  slug        String                                 @unique
  summary     String?                                @db.VarChar(300)
  content     Json?
  coverMediaId String?
  address     String
  location    Unsupported("geography(Point, 4326)")?
  status      ContentStatus                          @default(DRAFT)
  cityId      String
  authorId    String
  createdAt   DateTime                               @default(now())
  updatedAt   DateTime                               @updatedAt
  city        City                                   @relation(fields: [cityId], references: [id])
  author      User                                   @relation("PlaceAuthor", fields: [authorId], references: [id])
  events      Event[]
  categories  PlaceCategory[]
  favorites   PlaceFavorite[]
  coverMedia  MediaAsset?                            @relation("PlaceCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([authorId])
}

model Event {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  summary     String?           @db.VarChar(300)
  content     Json?
  coverMediaId String?
  price       Decimal           @db.Decimal(12, 2)
  capacity    Int?
  status      ContentStatus     @default(DRAFT)
  placeId     String
  authorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  place       Place             @relation(fields: [placeId], references: [id])
  author      User              @relation("EventAuthor", fields: [authorId], references: [id])
  occurrences EventOccurrence[]
  categories  EventCategory[]
  favorites   EventFavorite[]
  coverMedia  MediaAsset?       @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([authorId])
  @@index([placeId])
}

model EventOccurrence {
  id        String        @id @default(cuid())
  eventId   String
  startsAt  DateTime      @db.Timestamptz(3)
  endsAt    DateTime      @db.Timestamptz(3)
  timezone  String        @default("America/Bogota")
  status    ContentStatus @default(PENDING_REVIEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([startsAt])
  @@index([eventId, startsAt])
}

model Category {
  id        String          @id @default(cuid())
  name      String
  description String        @default("")
  scope     CategoryScope   @default(BOTH)
  slug      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  events    EventCategory[]
  places    PlaceCategory[]
}

enum CategoryScope {
  EVENT
  PLACE
  BOTH
}

model EventCategory {
  eventId    String
  categoryId String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
}

model PlaceCategory {
  placeId    String
  categoryId String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
}

model EventFavorite {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model PlaceFavorite {
  userId    String
  placeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  objectKey String?  @unique
  alt       String?
  mimeType  String?  @db.VarChar(32)
  size      Int?
  width     Int?
  height    Int?
  provider  String
  ownerId   String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  eventCovers Event[] @relation("EventCover")
  placeCovers Place[] @relation("PlaceCover")

  @@index([ownerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}
